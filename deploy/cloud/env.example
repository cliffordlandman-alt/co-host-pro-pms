# Copy to deploy/cloud/.env on the server (chmod 600). Never commit the real file. No secrets here.
# Your address. Free option without buying a domain: the VM's public IP with dashes + .sslip.io, e.g. 141-147-12-34.sslip.io
SITE_DOMAIN=
# Make both with:  openssl rand -hex 32
POSTGRES_PASSWORD=
SESSION_SECRET=
# Outgoing guest/owner messages (WhatsApp/email) stay OFF. Do not change without Clifford's say-so.
OUTBOUND_DELIVERY=off
# AI-staff relay to bots: off (bots collect messages with their key).
BOT_RELAY=off
# iCal calendar sync with Airbnb/Booking.com/Vrbo (works once the site is public).
SYNC_SCHEDULER=on
# Monthly draft owner statements as on the Mac (drafts only; nothing is sent while OUTBOUND_DELIVERY=off).
AUTO_STATEMENTS=on
# Optional, leave empty (each would only be used with OUTBOUND_DELIVERY=on or for AI features):
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# OPENAI_API_KEY=
